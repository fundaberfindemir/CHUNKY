# Bu dosyayı ".env" adıyla kopyalayın ve kendi anahtarlarınızı yazın.
# .env dosyası .gitignore içindedir, GitHub'a gitmez.
# Aşağıdaki değerler SAHTEDİR.

GEMINI_API_KEY=buraya-gemini-anahtarinizi-yazin

# Claude kullanmak isterseniz başındaki # işaretini kaldırın ve
# config.yaml içinde provider: claude yapın.
# ANTHROPIC_API_KEY=buraya-anthropic-anahtarinizi-yazin

# Ollama yerelde çalışır, anahtar gerekmez. Farklı adres kullanıyorsanız:
OLLAMA_HOST=http://localhost:11434
